# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
dist/
next-env.d.ts

# Environment — never commit real secrets.
# .env.example IS committed and documents what's needed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local database
*.db
*.sqlite
*.sqlite3

# FoodData Central mirror.
# Foundation Foods + SR Legacy are hundreds of MB and are rebuilt by the
# import script — they must never enter git history. Once a large file is
# committed it stays in the pack forever, so this rule matters more than
# the usual gitignore entry.
data/fdc-mirror/
data/fdc-cache/
data/*.csv
data/*.mdb
data/*.zip

# USDA special-interest databases (flavonoid / isoflavone / proanthocyanidin).
# Downloaded and converted by the import script.
data/usda-flavonoids/

# Test artifacts
coverage/
/test-results/
/playwright-report/

# Meal-photo regression set — real photos of real food, not for a public repo.
# Keep ground-truth JSON, ignore the images themselves.
test/fixtures/meal-photos/*.jpg
test/fixtures/meal-photos/*.jpeg
test/fixtures/meal-photos/*.png
test/fixtures/meal-photos/*.heic

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Vercel
.vercel

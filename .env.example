# Copy to .env.local and fill in. Never commit the filled-in version.
#
# Nothing here is needed to RUN the app today. `npm install && npm run dev`
# works on a fresh clone with no .env.local at all — every screen runs off the
# fixtures in data/demo. These are what each phase will need, and where each
# value comes from.

# ─────────────────────────────────────────────────────────────────────────────
# Database  — needed from Phase 0
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string. Neon and Supabase both provide one. For Neon,
# use the pooled connection string for the deployed app.
DATABASE_URL="postgresql://user:password@host:5432/nutritracker?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# USDA FoodData Central  — needed from Phase 0
# ─────────────────────────────────────────────────────────────────────────────
# Free key, instant signup: https://fdc.nal.usda.gov/api-key-signup.html
#
# Rate limited to 1,000 requests/hour, which is why Foundation Foods and
# SR Legacy get mirrored locally and only branded/barcode lookups hit the
# live API. See docs/RESEARCH.md.
FDC_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Auth  — needed from Phase 1
# ─────────────────────────────────────────────────────────────────────────────
# Better Auth signs sessions with this value. Generate a long random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Better Auth's canonical origin (no trailing slash).
# Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL. Used to build the OpenRouter OAuth callback.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Credential encryption  — needed from Phase 2
# ─────────────────────────────────────────────────────────────────────────────
# AES-256-GCM master key that encrypts users' own AI API keys at rest.
# Generate with:  openssl rand -base64 32
#
# LOSING THIS MEANS EVERY STORED USER KEY BECOMES UNDECRYPTABLE and every user
# has to reconnect. Back it up somewhere other than this repo. Rotating it
# requires decrypt-then-re-encrypt of the whole ai_credentials table.
ENCRYPTION_MASTER_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────
# Only for local development against your own key — the app is BYOK by design
# and ships no owner-funded fallback. See docs/DECISIONS.md (D2).
DEV_OPENROUTER_KEY=""

# Web push for streak alerts (Phase 3). Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
